# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source material kept locally, not committed.
# reference/Crew8_Website.html is the original ~33 MB single-file concept with every
# photograph inline as base64. assets/source-images/ holds the unmodified full-size
# photographs extracted from it. Both are archives, not build inputs: the optimized
# images committed under public/images/ are what the site actually serves.
# See README.md for how to restore them.
/reference/*.html
/assets/source-images
/tmp-slides
